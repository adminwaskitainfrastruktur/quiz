# Kuesioner WKI — iform.waskitainfrastruktur.co.id
# Letakkan file ini di folder akar subdomain (bersama index.html).

Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Paksa HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Tolak akses langsung ke file pengaturan, pustaka PHP, dan file tersembunyi
  RewriteRule ^api/(config|config\.sample|db)\.php$ - [F,L]
  RewriteRule (^|/)\. - [F,L]
</IfModule>

# Lapisan kedua bila mod_rewrite tidak aktif
<FilesMatch "^(config\.php|config\.sample\.php|db\.php)$|\.(sql|md|log|ini|bak)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # index.html selalu dicek ulang agar versi baru langsung terpakai
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # File di assets/ bernama unik per build → boleh disimpan lama di browser
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

AddDefaultCharset UTF-8
